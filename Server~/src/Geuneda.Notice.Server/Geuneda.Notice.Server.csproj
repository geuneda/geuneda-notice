<Project Sdk="Microsoft.NET.Sdk">
  <!--
    ASP.NET Core 공지 배포 헬퍼. 문서 형식(읽기, 규칙, 쓰기)은 Unity 패키지(Runtime/Document)의 것을 링크해 한 곳에서 관리한다.
    그래서 서버가 내려준 문서는 클라이언트도 같은 코드로 읽는다
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Geuneda.Notice.Server</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Geuneda.Notice.Server.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- Unity 의 com.unity.nuget.newtonsoft-json 3.2.1(13.0.2)과 같은 13.x -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup Label="Unity 패키지와 공유">
    <Compile Include="$(NoticePackageDir)Runtime/Document/*.cs" LinkBase="Shared/Document" />
  </ItemGroup>
</Project>
